# ================================================
#  U-Ride Backend — Variables de Entorno
#  Copia este archivo como .env y rellena los valores
#  NUNCA subas el .env real a Git
# ================================================

# ── Servidor ─────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Base de Datos PostgreSQL ──────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_NAME=uride

# ── Seguridad JWT ─────────────────────────────────
# Genera uno seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=reemplaza_con_una_clave_larga_y_segura_de_al_menos_64_caracteres

# ── Correo (SMTP via Gmail) ───────────────────────
# Usa una App Password de Google (no tu contraseña real)
# Guía: https://support.google.com/accounts/answer/185833
GMAIL_EMAIL=tu_correo@gmail.com
GMAIL_PASSWORD=xxxx_xxxx_xxxx_xxxx
GMAIL_SMTP_HOST=smtp.gmail.com

SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# ── URLs de otros servicios ───────────────────────
FRONTEND_URL=http://localhost:5173
MOBILE_URL=exp://localhost:8081

# ── Admin inicial (seed de la BD) ────────────────
ADMIN_EMAIL=admin@uta.edu.ec
ADMIN_PASSWORD=cambia_esta_clave
ADMIN_NAME=Administrador

# ── Stripe (pagos) ───────────────────────────────
# Clave de prueba: empieza con sk_test_
STRIPE_SECRET_KEY=sk_test_tu_clave_aqui
