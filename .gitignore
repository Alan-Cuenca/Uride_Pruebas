# ===============================================
# Proyecto U-Ride - Monorepo GitIgnore
# ===============================================

# 1. Dependencias globales
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 2. Variables de entorno — NUNCA subir al repo
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
mobile/.env
# Los .env.example SÍ se suben (son plantillas sin datos reales)
!.env.example
!backend/.env.example
!frontend/.env.example
!mobile/.env.example

# 3. Certificados y claves privadas
*.pem
*.key
*.p12
*.jks
*.keystore
*.mobileprovision

# 4. Builds y compilados — Frontend / Web
frontend/dist/
frontend/build/
.tsbuildinfo

# 5. Builds y compilados — React Native / Mobile
mobile/.expo/
mobile/dist/
mobile/web-build/
mobile/android/app/build/
mobile/android/build/
mobile/android/.gradle/
mobile/ios/build/
mobile/ios/Pods/

# 6. Backend — archivos generados
backend/logs/
backend/coverage/
backend/uploads/
coverage/

# 7. IDEs y Sistema Operativo
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 8. Testing
.jest-test-results.json

# 9. Documentación interna (no relevante para el repo)
Latex/
documentacion/
TAREAS_URIDE.md

# 10. Herramientas de CI/CD locales
.jenkins/

# Screenshots y videos de Cypress (generados en ejecuci�n)
frontend/cypress/screenshots/
frontend/cypress/videos/
frontend/.nyc_output/
cypress.env.json
